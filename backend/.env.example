# Choose which natural-language parser POST /api/chat should use.
# Options:
#   regex     - deterministic keyword/regex parser, no API key needed (default)
#   openai    - GPT-4o-mini function calling (requires OPENAI_API_KEY)
#   anthropic - Claude tool-use (requires ANTHROPIC_API_KEY)
PARSER_MODE=regex

# OpenAI mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

PORT=3000
